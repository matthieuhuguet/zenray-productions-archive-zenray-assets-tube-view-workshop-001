// 12 October 2026: same payload as BeginProject.mjs / Client.mjs, with a long timeout because the bridge snapshot is slow on 4 400-file projects.
// FR : même charge utile que BeginProject.mjs, avec un délai long (le snapshot du pont est lent sur les gros projets).
import { readFile } from 'node:fs/promises'
const root = '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress'
const config = JSON.parse(await readFile(`${root}/scripts/AssetsConfig.json`, 'utf8'))
const secret = (await readFile(`${root}/.env.local`, 'utf8')).match(/^\s*ZENRAY_API_SECRET\s*=\s*(.*?)\s*$/m)?.[1]?.replace(/^["']|["']$/g, '')
const payload = JSON.parse(process.argv[2])
const response = await fetch(`http://127.0.0.1:${config.bridge.port}${config.bridge.path}`, { method: 'POST', headers: { 'content-type': 'application/json', 'x-zr-assets-client': '2', ...(secret ? { 'x-zr-auth': secret } : {}) }, body: JSON.stringify(payload), signal: AbortSignal.timeout(Number(process.argv[3] || 300000)) })
const text = await response.text()
console.log(response.status, text.slice(0, Number(process.argv[4] || 3000)))
